DEBUG=False
SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_URL=http://localhost:3000
DEFAULT_FROM_EMAIL=noreply@terremergn.local

# PostgreSQL distant ou service géré
DATABASE_URL=postgresql://user:password@host:5432/terremergn

# Mailpit local: interface http://localhost:8025, SMTP localhost:1025
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False

# En production Render, remplacer ces valeurs par celles de votre fournisseur SMTP.
